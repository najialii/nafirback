{
  "info": {
    "name": "Nafir Backend - Auth & Mentorship API",
    "_postman_id": "d8f5f181-8572-4a1f-8e7d-9f3a0b7c6d5e",
    "description": "Postman collection for Authentication and Mentorship related tasks in the Nafir Backend API. \n\n**Variables:**\n* `{{baseUrl}}`: Base URL of the API (e.g., http://localhost:8000). The paths in this collection assume the API routes are prefixed with `/api` (e.g. `{{baseUrl}}/api/login`).\n* `{{authToken}}`: Authentication token obtained after login. Add this to the 'Authorization' header as 'Bearer {{authToken}}' for protected endpoints. The Login request includes a test script to attempt to automatically set this variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Requests related to user authentication and basic user info.",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"department_id\": 1,\n  \"user_type\": \"mentee\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            },
            "description": "Registers a new user.\n\n**Body Parameters:**\n* `name` (string, required): User's full name.\n* `email` (string, email, required): User's email address.\n* `password` (string, min:8, required): User's password.\n* `password_confirmation` (string, required): Must match the password.\n* `department_id` (integer, optional): ID of the user's department.\n* `user_type` (string, optional, enum: 'mentor', 'mentee', 'admin', default: 'mentee'): Type of user."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"authToken\", jsonData.token);",
                  "        console.log('Auth token set from response token field.');",
                  "    } else if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
                  "        console.log('Auth token set from response data.token field.');",
                  "    }",
                  "} catch (e) {",
                  "    console.log('Error parsing login response or token not found:', e);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "Logs in an existing user and returns an authentication token.\n\n**Body Parameters:**\n* `email` (string, email, required): User's email address.\n* `password` (string, required): User's password.\n\n**Test Script:** Attempts to automatically save the `token` from the response to the `{{authToken}}` collection variable."
          },
          "response": []
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logout"]
            },
            "description": "Logs out the currently authenticated user (invalidates token). Requires `Authorization: Bearer {{authToken}}` header."
          },
          "response": []
        },
        {
          "name": "Get Authenticated User Data (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "me"]
            },
            "description": "Retrieves the data for the currently authenticated user. Requires `Authorization: Bearer {{authToken}}` header."
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", ":id"],
              "variable": [
                { "key": "id", "value": "1", "description": "ID of the user to retrieve." }
              ]
            },
            "description": "Retrieves a specific user by their ID. Requires `Authorization: Bearer {{authToken}}` header."
          },
          "response": []
        },
        {
          "name": "Send Email Verification Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/email/verification-notification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "email", "verification-notification"]
            },
            "description": "Sends an email verification link to the authenticated user if their email is not yet verified. Requires `Authorization: Bearer {{authToken}}` header."
          },
          "response": []
        },
        {
          "name": "Verify Email Address",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/verify-email/:id/:hash?expires=YOUR_EXPIRATION_TIMESTAMP&signature=YOUR_SIGNATURE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verify-email", ":id", ":hash"],
              "query": [
                  {"key": "expires", "value": "YOUR_EXPIRATION_TIMESTAMP", "description": "Expiration timestamp from the verification link."},
                  {"key": "signature", "value": "YOUR_SIGNATURE", "description": "Signature from the verification link."}
              ],
              "variable": [
                { "key": "id", "value": "1", "description": "(Required) User ID from the verification link." },
                { "key": "hash", "value": "your_verification_hash", "description": "(Required) Hash from the verification link." }
              ]
            },
            "description": "Verifies the user's email address using the ID and hash from the verification link. This is typically accessed by clicking the link in the email. The `expires` and `signature` query parameters are part of Laravel's signed URL verification and should be included as they appear in the email link."
          },
          "response": []
        }
      ]
    },
